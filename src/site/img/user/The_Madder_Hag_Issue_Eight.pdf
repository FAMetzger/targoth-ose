   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">A traveler walks across a vibrant landscape, approaching a massive turtle with a beautifully decorated shell, evoking a sense of wonder and adventure, digital art style, illustration painting</rdf:li>
    </rdf:Alt>
