      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The Madder Hag is designed for use with the basic, expert, (&amp; advanced) editions of the original fantasy adventure game, and is therefore compatible with the vast treasure store of old-school rules such as Old School Essentials, Labyrinth Lord, original A/D&amp;D, and the like.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:rights>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Writing &amp; interior art by Quentin Bauer. Copyright Â©2026. All rights reserved.</rdf:li>
            </rdf:Alt>
         </dc:rights>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The Madder Hag Issue 08</rdf:li>
            </rdf:Alt>
         </dc:title>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:xapRights="http://ns.adobe.com/xap/1.0/rights/">
         <xapRights:Marked>True</xapRights:Marked>
